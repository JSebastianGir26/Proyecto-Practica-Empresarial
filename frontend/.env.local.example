# ============================================================
# Variables de entorno del frontend — PLANTILLA
#
# 1. Copia este archivo como .env.local (en esta carpeta frontend/)
#      Windows:  copy .env.local.example .env.local
#      Mac/Linux: cp .env.local.example .env.local
# 2. .env.local NUNCA se sube a GitHub.
#
# Solo las variables que empiezan por NEXT_PUBLIC_ llegan al navegador:
# nunca pongas claves secretas en una variable NEXT_PUBLIC_.
# ============================================================

# URL de la API Django (en local corre en el puerto 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
