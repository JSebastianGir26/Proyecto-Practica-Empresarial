# ============================================================
# Variables de entorno del backend — PLANTILLA
#
# 1. Copia este archivo como .env (en esta misma carpeta backend/)
#      Windows:  copy .env.example .env
#      Mac/Linux: cp .env.example .env
# 2. El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ============================================================

DEBUG=True
SECRET_KEY=cambia-esto-por-cualquier-texto-largo-en-local

# Base de datos.
# Déjala comentada para usar SQLite en local (recomendado para empezar,
# no hay que instalar nada). Cada desarrollador tiene su propia base.
# NO pongas aquí la base de Supabase de producción.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/practiya

# Frontend que puede llamar a la API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Duración de la sesión (opcional)
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Supabase Storage (opcional en local). Si están vacías, los archivos
# subidos se guardan en la carpeta backend/media/.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=practiya
